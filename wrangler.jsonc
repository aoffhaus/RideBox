// Cloudflare Worker config. One-time setup is in README.md ("Hosting on Cloudflare").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ridebox",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // No public *.workers.dev or preview URLs: the site is only reachable on the
  // custom domain that Cloudflare Access protects.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // run the Worker (and its Access check) before serving any file
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ridebox",
      // paste the id printed by `npx wrangler d1 create ridebox`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "ridebox-data" }],
  "vars": {
    // max Claude coach requests per day (a guard against runaway cost)
    "COACH_DAILY_LIMIT": "40"
  },
  // ACCESS_TEAM_DOMAIN, ACCESS_AUD, ALLOWED_EMAILS and ANTHROPIC_API_KEY are
  // secrets: `npx wrangler secret put <NAME>`. Keep them out of this file.
  "observability": { "enabled": true }
}
