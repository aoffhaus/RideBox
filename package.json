{
  "name": "ridebox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "worker:dev": "npm run build && wrangler d1 migrations apply ridebox --local && wrangler dev --local",
    "deploy": "npm run build && wrangler d1 migrations apply ridebox --remote && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@garmin/fitsdk": "^21.222.0",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@types/web-bluetooth": "^0.0.20",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^4.165.0"
  }
}
